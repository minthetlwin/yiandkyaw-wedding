# The site's public address, used for link previews (Messenger, WhatsApp, Viber…).
# Chat apps only show the share photo when its URL is absolute. Not a secret.
#
# Only a fallback, for builds made on your own computer (e.g. drag-and-drop
# deploys). When Netlify, Vercel or Cloudflare Pages build the site, the address
# they report wins, so renaming the site there can't leave previews pointing at
# an old address. Check the live result with: npm run check:share
SITE_URL=https://kyawandshwe.netlify.app
